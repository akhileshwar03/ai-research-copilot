# Backend API URL — set this to your Render backend URL in production
NEXT_PUBLIC_API_URL=http://localhost:8000

# All API calls from the frontend use the versioned prefix.
# Do not change this unless you are deliberately migrating to a new API version.
NEXT_PUBLIC_API_PREFIX=/api/v1

# Canonical production URL — used for SEO metadata (og:url, metadataBase).
NEXT_PUBLIC_SITE_URL=https://www.querex.app

# Error monitoring — sign up at sentry.io, create a Next.js project, paste
# its DSN here. Blank = disabled (see sentry.*.config.ts — Sentry.init with
# an empty dsn no-ops the SDK entirely).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
