OPENAI_API_KEY=sk-...
JWT_SECRET_KEY=replace-with-a-long-random-secret-min-32-chars

# Must be Postgres with the pgvector extension available — SQLite can't run
# the RAG pipeline (see app/modules/rag/pgvector_store.py). Point this at a
# Neon project (a free branch works fine for local dev); the extension is
# enabled automatically by `alembic upgrade head`.
DATABASE_URL=postgresql://user:password@host/dbname

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Public URL of this backend — used as the OAuth redirect base.
APP_BASE_URL=http://localhost:8000
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Comma-separated emails auto-promoted to admin on every request (survives DB
# resets). Admins can promote others from /admin afterwards.
ADMIN_EMAILS=

# Tavily web search — powers Real-time AI. Blank = no live search grounding.
TAVILY_API_KEY=

# Humaniser pipeline — separate models so this feature never silently falls
# back to OPENAI_CHAT_MODEL. Rewrite is the creative pass; classify backs the
# cheap analyze/verify passes. Rewrite must stay on a classic chat-completions
# model (not gpt-5-*) so the sampling params below actually take effect.
HUMANIZER_REWRITE_MODEL=gpt-4.1-mini
HUMANIZER_CLASSIFY_MODEL=gpt-4.1-mini
HUMANIZER_REWRITE_TEMPERATURE=0.85
HUMANIZER_REWRITE_TOP_P=1.0
HUMANIZER_REWRITE_FREQUENCY_PENALTY=0.0
HUMANIZER_REWRITE_PRESENCE_PENALTY=0.0
HUMANIZER_NUM_CANDIDATES=3

# "Ultra Human" tab — the fine-tuned LoRA, served by a local Ollama instance.
# Unset/unreachable is fine: the endpoint returns a clean "unavailable" error.
HUMANIZER_ULTRA_OLLAMA_URL=http://localhost:11434
HUMANIZER_ULTRA_MODEL=humaniser-lora
HUMANIZER_ULTRA_TIMEOUT_SECONDS=180
# Per-request word ceiling for Ultra only (a latency budget — see config.py).
HUMANIZER_ULTRA_MAX_WORDS=600
ENVIRONMENT=development
DEBUG=false

# Error monitoring — sign up at sentry.io, create a Python/FastAPI project,
# paste its DSN here. Blank = disabled (sentry_sdk.init is never called).
SENTRY_DSN=
AUTO_CREATE_TABLES=false
# Per-IP rate limiting (slowapi). Limits themselves are adjustable from /admin.
RATE_LIMIT_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_UPLOAD_SIZE_MB=20
# Days documents/chats are kept before cleanup (0 = forever). Also adjustable from /admin.
RETENTION_DAYS=7
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.8

# Cloudflare R2 (S3-compatible) — private object storage for uploaded PDFs.
# Leave all four blank to fall back to local disk (fine for local dev; do
# NOT rely on this in production, Render's disk is wiped on every redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email — Resend (recommended) or SMTP fallback. With neither configured,
# OTP codes are echoed in the API response (dev only).
RESEND_API_KEY=
EMAIL_FROM=Querex <noreply@querex.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 2 finetune scripts only (backend/scripts/finetune/) — read directly
# via os.environ, not through the app's Settings class, since these never run
# in production. GROQ_API_KEY and GOOGLE_API_KEY are also used this way and
# already assumed present by tag.py/aiify_api.py.
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# OAuth — fill in to enable social login (Google and GitHub are implemented)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
