OPENAI_API_KEY=sk-...
JWT_SECRET_KEY=replace-with-a-long-random-secret-min-32-chars

# Must be Postgres with the pgvector extension available — SQLite can't run
# the RAG pipeline (see app/modules/rag/pgvector_store.py). Point this at a
# Neon project (a free branch works fine for local dev); the extension is
# enabled automatically by `alembic upgrade head`.
DATABASE_URL=postgresql://user:password@host/dbname

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Humaniser pipeline — separate models so this feature never silently falls
# back to OPENAI_CHAT_MODEL. Rewrite is the creative pass; classify backs the
# cheap analyze/verify passes. Rewrite must stay on a classic chat-completions
# model (not gpt-5-*) so the sampling params below actually take effect.
HUMANIZER_REWRITE_MODEL=gpt-4.1-mini
HUMANIZER_CLASSIFY_MODEL=gpt-5-nano
HUMANIZER_REWRITE_TEMPERATURE=1.05
HUMANIZER_REWRITE_TOP_P=0.97
HUMANIZER_REWRITE_FREQUENCY_PENALTY=0.55
HUMANIZER_REWRITE_PRESENCE_PENALTY=0.35
ENVIRONMENT=development
DEBUG=false
AUTO_CREATE_TABLES=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6

# Cloudflare R2 (S3-compatible) — private object storage for uploaded PDFs.
# Leave all four blank to fall back to local disk (fine for local dev; do
# NOT rely on this in production, Render's disk is wiped on every redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email / SMTP — OTPs are logged to console when not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Phase 2 finetune scripts only (backend/scripts/finetune/) — read directly
# via os.environ, not through the app's Settings class, since these never run
# in production. GROQ_API_KEY and GOOGLE_API_KEY are also used this way and
# already assumed present by tag.py/aiify_api.py.
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# OAuth — uncomment and fill in to enable social login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
