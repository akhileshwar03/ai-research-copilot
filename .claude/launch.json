{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "frontend-prod",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "backend-local",
      "cwd": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=sqlite:///./app.db ADMIN_EMAILS=admin@example.com ENVIRONMENT=development RATE_LIMIT_ENABLED=false AUTO_CREATE_TABLES=true venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "frontend-local",
      "cwd": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_API_URL=http://127.0.0.1:8010 NEXT_PUBLIC_API_PREFIX=/api/v1 npm run dev -- -p 3050"
      ],
      "port": 3050
    }
  ]
}